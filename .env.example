# Copy this file to .env, then replace every example value.
# Do not put passwords or tokens here; deploy/secrets/ is used for secrets.

HOME_TUNNEL_VERSION=7.0.0
HOME_TUNNEL_CONSOLE_HOST=console.tunnel.example.com
HOME_TUNNEL_TUNNEL_DOMAIN=tunnel.example.com
HOME_TUNNEL_PUBLIC_BASE_URL=https://console.tunnel.example.com
HOME_TUNNEL_FRPS_PUBLIC_HOST=203.0.113.10
HOME_TUNNEL_FRPS_BIND_ADDRESS=0.0.0.0
HOME_TUNNEL_FRPS_PORT=7000
# 可视化管理：首次叠加 deploy/compose.ports.yaml 即可准备默认 10000-10009
# 的 TCP/UDP 端口池，不必修改下面变量；之后在后台「系统设置」启用。
# 可选扩容参数（与旧 TCP/UDP/L4 覆盖文件选择一种方式）：
# HOME_TUNNEL_MANAGED_BIND_ADDRESS=0.0.0.0
# HOME_TUNNEL_MANAGED_PORT_START=10000
# HOME_TUNNEL_MANAGED_PORT_END=10009
# 端口隧道默认关闭。叠加 deploy/compose.tcp.yaml / compose.udp.yaml /
# compose.l4.yaml 前必须显式设置对应范围；未设置时 Compose 会失败，
# 而不是默认打开 100 个公网端口。下面是只开放一个 TCP 端口的例子：
# HOME_TUNNEL_TCP_BIND_ADDRESS=0.0.0.0
# HOME_TUNNEL_TCP_PORT_START=10554
# HOME_TUNNEL_TCP_PORT_END=10554
# HOME_TUNNEL_UDP_BIND_ADDRESS=0.0.0.0
# HOME_TUNNEL_UDP_PORT_START=10554
# HOME_TUNNEL_UDP_PORT_END=10554
# compose.l4.yaml 同时启用 TCP/UDP，并使用下面这组共享范围。
# HOME_TUNNEL_L4_BIND_ADDRESS=0.0.0.0
# HOME_TUNNEL_L4_PORT_START=10554
# HOME_TUNNEL_L4_PORT_END=10554
HOME_TUNNEL_ACME_EMAIL=admin@example.com
HOME_TUNNEL_BOOTSTRAP_ADMIN_USERNAME=admin

# Optional alerting. Leave blank to disable a channel. Alerts fire on monthly
# traffic quota thresholds (80% / suspended / restored) and device offline /
# recovery. Telegram needs both the bot token and chat id to be set together.
# Monthly quotas themselves are configured per user in the admin console.
HOME_TUNNEL_ALERT_WEBHOOK_URL=
HOME_TUNNEL_ALERT_TELEGRAM_BOT_TOKEN=
HOME_TUNNEL_ALERT_TELEGRAM_CHAT_ID=
