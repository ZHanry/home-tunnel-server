global:
  scrape_interval: 30s
  evaluation_interval: 30s
rule_files: [/etc/prometheus/alerts.yml]
alerting:
  alertmanagers:
    - static_configs:
        - targets: [alertmanager:9093]
scrape_configs:
  - job_name: home-tunnel
    metrics_path: /internal/metrics
    static_configs:
      - targets: [control-center:8080]
    http_headers:
      X-Home-Tunnel-Key:
        files: [/run/secrets/internal_service_key]
  - job_name: console-https
    metrics_path: /probe
    params:
      module: [https_valid]
    static_configs:
      - targets: [__CONSOLE_URL__]
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox:9115
